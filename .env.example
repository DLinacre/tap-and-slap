# =============================================================================
# Tap & Slap — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`. =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL (production + dev). Free hosted options: Neon, Supabase, Railway.
# Example: postgresql://user:password@host:5432/tap_and_slap?schema=public
DATABASE_URL="postgresql://tap:tapdev@localhost:5432/tap_and_slap"

# --- Auth -------------------------------------------------------------------
# Generate a strong secret: `npx auth secret` or `openssl rand -base64 32`
# REQUIRED in production. In dev, the app falls back to a dev-only secret.
AUTH_SECRET=""

# --- App --------------------------------------------------------------------
# Public origin of the app (used for absolute URLs / callbacks).
# NOTE: in production leave this UNSET — the app derives the origin from the
# request headers and falls back to the production domain. A localhost value
# here would poison sitemap/robots/OG URLs.
NEXT_PUBLIC_APP_URL=""

# --- Feature flags (optional) ----------------------------------------------
# LOG_LEVEL=info            # debug | info | warn | error
# RATE_LIMIT_SCORES_PER_MIN=10
