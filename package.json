{
  "name": "tap-and-slap",
  "version": "0.1.0",
  "private": true,
  "description": "Tap & Slap \u2014 a dance-mat beat 'em up. Tap to kill enemies ON the beat. Built with Next.js 15 + Phaser 3 + TypeScript.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "bcryptjs": "^2.4.3",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.29",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "phaser3spectorjs": "^0.0.8",
    "playwright": "^1.52.0",
    "prisma": "7.9.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "beat-em-up",
    "browser-game",
    "dance-mat",
    "nextjs",
    "phaser",
    "rhythm-game",
    "synthwave",
    "tap-game",
    "typescript",
    "web-game"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DLinacre/tap-and-slap.git"
  },
  "bugs": {
    "url": "https://github.com/DLinacre/tap-and-slap/issues"
  }
}
